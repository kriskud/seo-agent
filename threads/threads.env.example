# Конфигурация Threads-агента. Боевая копия: /etc/seo-agent/threads.env, chmod 600.
# Токены доступа Threads здесь НЕ хранятся — они живут в базе (threads_tokens).
# Всё, что различается между аккаунтами, лежит в threads/accounts/<id>/account.json.

# Из кабинета Meta: App settings → Basic (SETUP_META.md, шаг 4). Одно приложение на все аккаунты.
THREADS_APP_ID=
THREADS_APP_SECRET=

# Пусто, если сервер видит graph.threads.net напрямую (проверено: видит)
THREADS_HTTP_PROXY=

# Генерация постов и оценка обсуждений
ANTHROPIC_API_KEY=
THREADS_LLM_MODEL=claude-sonnet-5
# Потолок расходов на AI за календарный месяц, $ на все аккаунты
THREADS_LLM_MONTHLY_BUDGET_USD=15

# Поиск обсуждений (serper.dev; 1 запрос = 1 кредит, 6 запросов в день на аккаунт)
SERPER_API_KEY=

# Telegram-бот для управления и уведомлений
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Часовой пояс владелицы (время в сообщениях бота, еженедельный отчёт)
THREADS_TZ=Europe/Moscow
# На сколько дней вперёд держать очередь
THREADS_QUEUE_DAYS=3
