# Конфигурация Threads-агента. Боевая копия: /etc/seo-agent/threads.env, chmod 600.
# Токен доступа Threads здесь НЕ хранится — он живёт в базе (threads_auth).

# Из кабинета Meta: App settings → Basic (SETUP_META.md, шаг 4)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Пусто, если сервер видит graph.threads.net напрямую (проверено: видит)
THREADS_HTTP_PROXY=

# Ключ Anthropic (нужен с фазы 3 — генерация текстов)
ANTHROPIC_API_KEY=
THREADS_LLM_MODEL=claude-sonnet-5

# Telegram-бот для черновиков и уведомлений (нужен с фазы 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Расписание публикаций (МСК)
THREADS_POSTS_PER_DAY=1
THREADS_POST_SLOTS=10:30,19:30
THREADS_POST_WEEKDAYS=1,2,3,4,5
THREADS_TZ=Europe/Moscow
